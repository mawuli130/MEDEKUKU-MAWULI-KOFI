# =====================================================================
# Mawuli Engineering & Diagnostic Services — environment template
# =====================================================================
# Copy to `.env` for local development and add the same keys to your
# Vercel project (Settings → Environment Variables).
#
# NEVER commit a real .env file. NEVER add the Supabase service-role key
# here: this is a browser bundle, and the service-role key bypasses RLS.
# =====================================================================

# --- Supabase (required for the live database) -----------------------
# Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings → API → Project API keys → "anon public"
# Only the anon key belongs in the frontend. RLS enforces authorisation.
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Site ------------------------------------------------------------
# Canonical origin used for canonical URLs, Open Graph and the sitemap.
# No trailing slash. Use your production domain in production.
VITE_SITE_URL=https://mawuli-diagnostics.vercel.app

# --- Optional: local preview -------------------------------------------------
# With VITE_DEMO_MODE=true (or with no Supabase values at all) the app runs against
# browser-local storage so the site and dashboard can be reviewed offline.
# This is NOT a production data source.
# VITE_DEMO_MODE=false

# Credentials for the local preview sign-in. They only apply when the
# Supabase variables above are absent or VITE_DEMO_MODE=true.
# VITE_DEMO_ADMIN_EMAIL=admin@mawulidiagnostics.com
# VITE_DEMO_ADMIN_PASSWORD=Diagnostics2026!
