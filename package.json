{
  "name": "mawuli-engineering-diagnostic-services",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Automotive engineering, electronics and vehicle diagnostics portfolio of Medekuku Mawuli Kofi (Accra, Ghana).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs && node scripts/generate-sitemap.mjs",
    "build:client": "vite build",
    "preview": "node scripts/serve-dist.mjs 4180",
    "typecheck": "tsc -b --pretty",
    "lint": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:routes": "node scripts/test-routes.mjs http://localhost:4180",
    "serve:dist": "node scripts/serve-dist.mjs",
    "test:sql": "node scripts/test-sql.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
